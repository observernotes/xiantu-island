{
  "name": "xiantu-island",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm run sync && vite --host 0.0.0.0 --port 5173",
    "build": "npm run sync && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:overflow": "node scripts/overflow-test.mjs",
    "test:v05": "timeout 60s node scripts/v05-test.mjs",
    "test:appearance": "timeout 60s node scripts/appearance-test.mjs",
    "test:classes": "timeout 120s node scripts/classes-test.mjs",
    "test:smoke:classes": "timeout 120s node scripts/classes-smoke.mjs",
    "test:daily": "timeout 60s node scripts/daily-test.mjs",
    "test:smoke:daily": "timeout 120s node scripts/daily-smoke.mjs",
    "test:sect-growth": "timeout 60s node scripts/sect-growth-test.mjs",
    "test:smoke:sect-growth": "timeout 120s node scripts/sect-growth-smoke.mjs",
    "test:altar": "timeout 60s node scripts/altar-test.mjs",
    "test:alchemy": "timeout 60s node scripts/alchemy-test.mjs && timeout 60s node scripts/gather-test.mjs",
    "test:smoke:alchemy": "timeout 120s node scripts/alchemy-smoke.mjs",
    "test:smoke:v05": "timeout 120s node scripts/v05-smoke.mjs",
    "sync": "node scripts/sync.mjs",
    "snapshot": "node scripts/snapshot.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
